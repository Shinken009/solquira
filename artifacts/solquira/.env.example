# Solquira basemap configuration (build-time, consumed by Vite).
#
# Default: public OpenStreetMap raster tiles. They are best-effort, require the
# visible attribution already rendered by Cesium, and are not a production SLA.
# For paid traffic or contractual availability, select a contracted provider.
#
# osm | maptiler | custom
VITE_BASEMAP_PROVIDER=osm

# MapTiler (recommended example of a contracted OSM-derived service).
# Restrict the key to the deployed domain in the MapTiler dashboard.
# VITE_BASEMAP_API_KEY=

# Custom XYZ provider. Must be HTTPS and contain {z}, {x} and {y}.
# The host must also be added to img-src/connect-src in vercel.json.
# VITE_BASEMAP_URL=https://tiles.example.com/{z}/{x}/{y}.png
# VITE_BASEMAP_ATTRIBUTION=© Example Maps / © OpenStreetMap contributors
# VITE_BASEMAP_MAX_LEVEL=18

# Do not commit real keys or deployment secrets to this file.
