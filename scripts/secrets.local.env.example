# Solquira — credential template.
# Copy this file to `secrets.local.env` in the same folder and fill exactly one line.
# The file you create is git-ignored and must never be committed.
#
# The isolated loader accepts:
#   - exactly one `NEBIUS_API_KEY=` line
#   - no quotes, no `export`, no trailing spaces
#   - no second key definition anywhere in the file

NEBIUS_API_KEY=
